# Flask
# Gere uma chave longa e aleatória antes de publicar em produção.
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
FLASK_DEBUG=0

# Banco de dados
# Deixe vazio para usar o SQLite local (inventario.db).
# Para PostgreSQL, informe a URL completa, por exemplo:
# postgresql://usuario:senha@host:5432/inventario_ti
DATABASE_URL=

# Integração Pulsus (opcional)
PULSUS_TOKEN=
PULSUS_BASE_URL=https://api.pulsus.mobi

# Integração OpenEdge (opcional)
OPENEDGE_URL=
OPENEDGE_USER=
OPENEDGE_PASSWORD=
OPENEDGE_JAR=./openedge.jar
